# === tradagent config ===
# Copy this file to .env — ALL keys are optional! The app works out of the box.

# Gemini (optional — without it, the fast local engine is used)
GOOGLE_GEMINI_API_KEY=

# LunarCrush (optional — without it, market data + local score are used)
LUNARCRUSH_API_KEY=

# Discord webhook for alerts (optional)
DISCORD_WEBHOOK_URL=

# Settings
TRADAGENT_SYMBOLS=BTC,ETH,SOL,BNB,XRP
TRADAGENT_CURRENCY=usd
TRADAGENT_DB_PATH=data/tradagent.db
TRADAGENT_CACHE_TTL=300
