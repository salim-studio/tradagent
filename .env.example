# === tradagent config ===
# انسخ هذا الملف إلى .env — كل المفاتيح اختيارية! البرنامج يعمل بدونها.
# Copy to .env — ALL keys optional! App works out-of-the-box.

# Gemini (اختياري — بدونها يعمل المحرك المحلي السريع)
GOOGLE_GEMINI_API_KEY=

# LunarCrush (اختياري — بدونها يستخدم بيانات السوق + سكور محلي)
LUNARCRUSH_API_KEY=

# Discord webhook للتنبيهات (اختياري)
DISCORD_WEBHOOK_URL=

# إعدادات
TRADAGENT_SYMBOLS=BTC,ETH,SOL,BNB,XRP
TRADAGENT_CURRENCY=usd
TRADAGENT_DB_PATH=data/tradagent.db
TRADAGENT_CACHE_TTL=300
